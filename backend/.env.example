# Spring Boot Active Profile (dev or prod)
SPRING_PROFILES_ACTIVE=prod

# Remote PostgreSQL Database (e.g., Neon.tech, AWS RDS)
DB_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Stripe API Keys (Live or Test Mode)
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Brevo SMTP Settings (for Email Confirmations)
BREVO_SMTP_USER=your_brevo_email
BREVO_SMTP_PASS=your_brevo_smtp_password

# JWT Security
JWT_SECRET=your_super_secret_jwt_signing_key_here

# Frontend URL (for Stripe redirects)
FRONTEND_URL=https://your-production-domain.com
